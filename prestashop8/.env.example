HTTP_PORT=8088
PS_DOMAIN=localhost:8088
PS_ADMIN_DIR=admin-dev

ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=Dev123456!

# Supported: 8.0.1, 8.0.2, 8.0.4, 8.1.0-8.1.7, and 8.2.0-8.2.8.
PRESTASHOP_VERSION=8.2.8
# Official release asset for the selected version, for example:
# https://github.com/PrestaShop/PrestaShop/releases/download/8.2.8/prestashop_8.2.8.zip
PRESTASHOP_ARCHIVE_URL=

# Optional Xdebug build (0 or 1):
INSTALL_XDEBUG=0

# On ARM64 only, uncomment to opt in to amd64 emulation:
# DOCKER_DEFAULT_PLATFORM=linux/amd64
