HTTP_PORT=8090
PS_DOMAIN=localhost:8090
PS_ADMIN_DIR=admin-dev

ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=Dev123456!

# Supported: 9.0.0-9.0.3 and 9.1.0-9.1.5.
PRESTASHOP_VERSION=9.1.5
# Official release asset for the selected version, for example:
# https://assets.prestashop3.com/dst/edition/corporate/9.1.5-5.0/prestashop_edition_basic_version_9.1.5-5.0.zip
PRESTASHOP_ARCHIVE_URL=

# Optional Xdebug build (0 or 1):
INSTALL_XDEBUG=0

# On ARM64 only, uncomment to opt in to amd64 emulation:
# DOCKER_DEFAULT_PLATFORM=linux/amd64
